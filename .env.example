# ---------------------------------------------------------------------------
# Supabase — projeto único (dev + prod usam o mesmo projeto, ver ADR-0003)
# ---------------------------------------------------------------------------

# URL do projeto Supabase (público, exposto ao browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (público, exposto ao browser, protegido por RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service-role key — SOMENTE server-side. NUNCA prefixar com NEXT_PUBLIC.
# Usada apenas em rotinas administrativas e seeds. Ver RNF-SEC-004.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Pagamentos — Mercado Pago (ADR-0012)
# ---------------------------------------------------------------------------
# Em dev e CI, só credenciais de teste do painel (prefixo TEST-). Nunca commitar
# chaves reais. Só a public key pode ter o prefixo NEXT_PUBLIC.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
