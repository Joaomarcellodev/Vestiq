# ---------------------------------------------------------------------------
# Supabase — projeto único (dev + prod usam o mesmo projeto, ver ADR-0003)
# ---------------------------------------------------------------------------

# URL do projeto Supabase (público, exposto ao browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (público, exposto ao browser, protegido por RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service-role key — SOMENTE server-side. NUNCA prefixar com NEXT_PUBLIC.
# Usada apenas em rotinas administrativas e seeds. Ver RNF-SEC-004.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Pagamentos — Stripe (ADR-0012, SPEC-014)
# ---------------------------------------------------------------------------
# Só chaves da área restrita (sandbox) em dev e CI. Nunca commitar chaves.
# Prefira uma chave restrita (rk_test_…) com escrita em Checkout Sessions e
# Refunds e leitura em PaymentIntents.
# O webhook secret vem do endpoint no painel ou de
# `stripe listen --forward-to localhost:3000/api/payments/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
